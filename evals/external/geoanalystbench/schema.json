{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/muend/geoai-skills/evals/external/geoanalystbench/schema.json",
  "title": "GeoAnalystBench-derived external case",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "case_id",
    "upstream_task_id",
    "title",
    "skill",
    "prompt",
    "provenance",
    "fixture_generator",
    "reference",
    "validator",
    "input_paths",
    "expected_artifacts",
    "invariants"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "case_id": {
      "type": "string",
      "pattern": "^gab-[0-9]{2}-[a-z0-9-]+$"
    },
    "upstream_task_id": {
      "type": "integer",
      "minimum": 1,
      "maximum": 50
    },
    "title": {
      "type": "string",
      "minLength": 10
    },
    "skill": {
      "type": "string",
      "pattern": "^[a-z0-9-]+$"
    },
    "prompt": {
      "type": "string",
      "minLength": 100
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "adaptation",
        "fixture_origin",
        "upstream_task_url"
      ],
      "properties": {
        "adaptation": {
          "const": "independently-authored"
        },
        "fixture_origin": {
          "const": "deterministic-synthetic"
        },
        "upstream_task_url": {
          "type": "string",
          "pattern": "^https://github\\.com/GeoDS/GeoAnalystBench/"
        }
      }
    },
    "fixture_generator": {
      "$ref": "#/$defs/relativePythonPath"
    },
    "reference": {
      "$ref": "#/$defs/relativePythonPath"
    },
    "validator": {
      "$ref": "#/$defs/relativePythonPath"
    },
    "input_paths": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/relativePath"
      }
    },
    "expected_artifacts": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/relativePath"
      }
    },
    "invariants": {
      "type": "array",
      "minItems": 3,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 10
      }
    }
  },
  "$defs": {
    "relativePath": {
      "type": "string",
      "minLength": 1,
      "not": {
        "pattern": "(^/|^[A-Za-z]:|(^|/)\\.\\.(/|$)|\\\\)"
      }
    },
    "relativePythonPath": {
      "allOf": [
        {
          "$ref": "#/$defs/relativePath"
        },
        {
          "pattern": "\\.py$"
        }
      ]
    }
  }
}
