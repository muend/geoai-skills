      "description": "A separate uncertainty surface and four-fold spatial block validation support the risk claim.",
      "artifacts": ["outputs/uncertainty-surface.json", "outputs/validation-report.json", "outputs/provenance.json"],
      "required": true,
      "expected": {"uncertainty_surface_delivered": true, "validation_method": "four-fold spatial block cross-validation"}
