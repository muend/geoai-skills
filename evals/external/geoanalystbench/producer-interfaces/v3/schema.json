{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/muend/geoai-skills/evals/external/geoanalystbench/producer-interfaces/v3/schema.json",
  "title": "GeoAnalystBench-derived semantic producer interface v3",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "interface_id",
    "case_id",
    "base_freeze_id",
    "base_suite_sha256",
    "contract_freeze_id",
    "contract_suite_sha256",
    "disclosure_boundary",
    "execution_hints",
    "method_contract",
    "artifacts"
  ],
  "properties": {
    "schema_version": {"const": 3},
    "interface_id": {
      "type": "string",
      "pattern": "^geoanalystbench-producer-interface-v3/gab-[0-9]{2}-[a-z0-9-]+$"
    },
    "case_id": {"type": "string", "pattern": "^gab-[0-9]{2}-[a-z0-9-]+$"},
    "base_freeze_id": {"const": "geoanalystbench-derived-v1"},
    "base_suite_sha256": {
      "const": "c99563100cacc1e03234edd82ec64f4f47dc9479ca2ca4f9aabe84a1d5373f12"
    },
    "contract_freeze_id": {"const": "geoanalystbench-derived-contracts-v3"},
    "contract_suite_sha256": {
      "const": "e17b9ee3f6d69ba99aacc90cab998339bf0f679c76ce25645e09a70e882ad3f2"
    },
    "disclosure_boundary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["includes", "excludes"],
      "properties": {
        "includes": {
          "const": ["artifact paths", "nested field names", "formats", "method evidence", "serialization rules", "execution hints"]
        },
        "excludes": {
          "const": ["reference outputs", "expected analytical values", "validator source"]
        }
      }
    },
    "execution_hints": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 12}
    },
    "method_contract": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 12}
    },
    "artifacts": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path", "format", "required_fields", "requirements"],
        "properties": {
          "path": {"type": "string", "pattern": "^outputs/[A-Za-z0-9._-]+$"},
          "format": {"enum": ["CSV", "JSON", "GeoJSON", "SVG"]},
          "required_fields": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {"type": "string", "minLength": 1}
          },
          "requirements": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {"type": "string", "minLength": 8}
          }
        }
      }
    }
  }
}
